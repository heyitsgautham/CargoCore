# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# First password for the reserved logisticmanager@gmail.com admin, applied only when the
# account is created. Leave it empty to get a random one, printed in the log outside production.
ADMIN_BOOTSTRAP_PASSWORD=

# ─── Database ─────────────────────────────────────────────────────────────────
# Used by docker-compose for the postgres container
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_pass
POSTGRES_DB=logistics_db

# Full DSN used by the FastAPI app (asyncpg driver)
# Use @db for Docker, @localhost for local/manual run
DATABASE_URL=postgresql+asyncpg://logistics_user:logistics_pass@localhost:5432/logistics_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google APIs ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# ─── Daily.co Video Conferencing ──────────────────────────────────────────────
DAILY_API_KEY=

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Email / SMS (optional — Phase 7) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true writes one JSON object per line. Leave unset to follow APP_ENV (on in production).
# LOG_JSON=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
