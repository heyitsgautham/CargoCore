# Environment for `docker compose up` at the repo root.
# Copy to .env and edit. Every value below has a working default, so the file is optional.
# For running the services without Docker, use backend/.env.example and frontend/.env.example.

# ─── Backend application ─────────────────────────────────────────────────────
APP_ENV=development
# Signs JWTs. Use 32 or more random characters outside local development.
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
# First password for the reserved logisticmanager@gmail.com admin, applied only when the
# account is created. Leave it empty to get a random one, printed in the log outside production.
ADMIN_BOOTSTRAP_PASSWORD=
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
# true writes one JSON object per line. Leave unset to follow APP_ENV (on in production).
# LOG_JSON=true

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_pass
POSTGRES_DB=logistics_db
# docker-compose.yml builds DATABASE_URL from the three values above with host `db`.
# Set it yourself only when the API runs outside Docker.
DATABASE_URL=postgresql+asyncpg://logistics_user:logistics_pass@localhost:5432/logistics_db

# ─── Redis ───────────────────────────────────────────────────────────────────
# docker-compose.yml points the API at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# ─── Third-party APIs (optional, features degrade without them) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
DAILY_API_KEY=

# ─── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Email (optional) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Web app build (baked into the bundle by Vite) ──────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
